# Rendered by entrypoint.sh at container start — ${VAR} placeholders are
# substituted from the environment (see the redis section of the root .env).
# Do not edit the generated file; edit this template.

# --- Network Settings ---
# Listen on all container network interfaces (0.0.0.0)
bind 0.0.0.0
port ${REDIS_PORT}

# --- Security ---
# Require authentication password
requirepass ${REDIS_PASSWORD}

# --- Persistence ---
# Append Only Mode (saves every write operation to disk)
appendonly ${REDIS_APPENDONLY}
appendfilename "appendonly.aof"

# Save snapshots to disk (RDB)
# Save after 300 sec if 1 key changed, or after 60 sec if 10000 keys changed
save 300 1
save 60 10000

# --- Memory Management ---
# Max memory limit (e.g., 256 megabytes)
maxmemory ${REDIS_MAXMEMORY}
# Eviction policy when memory is full (removes least recently used keys with an expiration)
maxmemory-policy ${REDIS_MAXMEMORY_POLICY}

# --- Logging ---
loglevel ${REDIS_LOGLEVEL}
