FROM debian:12

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    postgresql \
    postgresql-contrib \
    procps && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/lib/postgresql/15/main /var/run/postgresql /var/log/postgresql && \
    chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql /var/log/postgresql /etc/postgresql

# 👇 FIX: Explicitly set listen addresses AND unix socket directories inside the configuration file
RUN echo "listen_addresses='*'" >> /etc/postgresql/15/main/postgresql.conf && \
    echo "unix_socket_directories='/var/run/postgresql'" >> /etc/postgresql/15/main/postgresql.conf && \
    echo "host all all 0.0.0.0/0 md5" >> /etc/postgresql/15/main/pg_hba.conf

COPY ./setup.sh /usr/local/bin/init-db.sh
RUN chmod +x /usr/local/bin/init-db.sh

ENV PATH="/usr/lib/postgresql/15/bin:$PATH"

USER postgres

EXPOSE 5432

ENTRYPOINT ["/usr/local/bin/init-db.sh"]

