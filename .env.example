# ============================================================
# ft_transcendence — environment template
# Copy to .env  (make env)  and fill in real values.
# The .env file is git-ignored: NEVER commit real secrets.
# ============================================================

# ---------- Public URLs (what the browser sees) ----------
# Everything is served through nginx on this single HTTPS origin.
PUBLIC_URL=https://localhost:8443
NEXT_PUBLIC_BACKEND_URL=https://localhost:8443
NEXT_PUBLIC_FRONTEND_URL=https://localhost:8443

# ---------- Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
DB_NAME=transcendence
DB_USER=transcendence
DB_PASSWORD=change-me-strong-password
# Read-only monitoring user (pg_monitor role, NOT superuser)
EXPORTER_PASSWORD=change-me-strong-password

# ---------- Auth (better-auth) ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=https://localhost:8443

# OAuth providers (leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SCHOOL42_CLIENT_ID=
SCHOOL42_CLIENT_SECRET=

# ---------- Code judge (RustBox) ----------
RUSTBOX_API_KEY=your-rustbox-api-key

# ---------- Monitoring ----------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
# Alert e-mails (optional — leave defaults to disable real sending)
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=team@example.com
ALERT_SMTP_PASSWORD=app-password-here
