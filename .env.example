# backend env variables
NODE_ENV=production

DATABASE_URL=postgresql://xxx:xxx@db:5432/xxx?sslmode=disable

BETTER_AUTH_SECRET=xxx
BETTER_AUTH_URL=https://localhost:8443

GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

SCHOOL42_CLIENT_ID=xxx
SCHOOL42_CLIENT_SECRET=xxx

X_API_KEY=xxx

# database env variables
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx

DB_NAME=xxx
DB_USER=xxx
DB_PASSWORD=xxx

EXPORTER_USER=xxx
EXPORTER_PASSWORD=xxx

# frontend env variables
NEXT_PUBLIC_BACKEND_URL=https://localhost:8443
NEXT_PUBLIC_FRONTEND_URL=https://localhost:8443
INTERNAL_BACKEND_URL=http://backend:3000

# redis env variables
REDIS_HOST=redis
REDIS_PORT=6378
REDIS_PASSWORD=xxx
REDIS_URL=redis://:xxx@redis:6378
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_LOGLEVEL=notice

# grafana env variables
GF_SECURITY_ADMIN_USER=xxx
GF_SECURITY_ADMIN_PASSWORD=xxx
GF_AUTH_ANONYMOUS_ENABLED=false

# postgres exporter env variables
POSTGRES_EXPORTER_PASSWORD=xxx
POSTGRES_EXPORTER_DSN=postgresql://exporter:${POSTGRES_EXPORTER_PASSWORD}@db:5432/postgres?sslmode=disable

# elasticsearch env variables
ELASTIC_PASSWORD=xxx
KIBANA_SYSTEM_PASSWORD=xxx

# SMTP env variables
ALERT_SMTP_HOST=xxx
ALERT_EMAIL_FROM=xxx
ALERT_EMAIL_TO=xx
ALERT_SMTP_PASSWORD=xxx

# kibana encryption keys (persist saved objects / alerting across restarts)
KIBANA_SECURITY_ENCRYPTION_KEY=xxx
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=xxx
KIBANA_REPORTING_ENCRYPTION_KEY=xxx