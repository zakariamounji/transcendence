global:
  resolve_timeout: 5m

route:
  group_by: ["alertname"]
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: email-notifications

receivers:
  - name: email-notifications
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        from: "${ALERT_EMAIL_FROM}"
        smarthost: "${ALERT_SMTP_HOST}"
        auth_username: "${ALERT_EMAIL_FROM}"
        auth_identity: "${ALERT_EMAIL_FROM}"
        auth_password: "${ALERT_SMTP_PASSWORD}"
        send_resolved: true
