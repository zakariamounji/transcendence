model Challenge {
  cid String @id @unique @default(uuid())

  title       String
  slug        String @unique
  description String

  difficulty Difficulty

  languages Language[]

  expReward Int @default(100)

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Creator
  createdById String
  createdBy User @relation(fields: [createdById], references: [uid])

  // Battles using this challenge
  battles Battle[]
}

model Battle {
  bid String @id @unique @default(uuid())

  mode BattleMode

  status BattleStatus @default(WAITING)

  visibility BattleVisibility @default(PUBLIC)

  maxPlayers Int

  roomCode String?

  durationSeconds Int @default(1160)

  createdAt DateTime @default(now())
  startedAt DateTime?
  endedAt DateTime?

  // Creator
  creatorId String
  creator User @relation("BattleCreator", fields: [creatorId], references: [uid])

  // Players
  players User[] @relation("BattlePlayers")

  // Winner
  winnerId String?
  winner User? @relation("BattleWinner", fields: [winnerId], references: [uid])

  // Challenge
  challengeId String
  challenge Challenge @relation(fields: [challengeId], references: [cid])
}