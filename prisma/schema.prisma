generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ONLINE
  OFFLINE
  IN_BATTLE
}

enum BattleMode {
  SOLO
  DUO
  GROUP
}

enum BattleStatus {
  WAITING
  RUNNING
  COMPLETED
  CANCELLED
}

enum BattleVisibility {
  PUBLIC
  PRIVATE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  GO
  RUST
}

model User {
  uid        String   @id @default(uuid())

  fullName String @default("Anonymous")
  email      String   @unique
  password   String
  avatar     String?

  role        UserRole   @default(USER)
  status      UserStatus @default(OFFLINE)

  level       Int @default(1)
  exp         Int @default(0)

  wins        Int @default(0)
  losses      Int @default(0)

  totalChallengesPlayed   Int @default(0)
  totalChallengesCreated  Int @default(0)

  lastSeen    DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // sentFriendRequests     FriendRequest[] @relation("FriendRequestsSent")
  // receivedFriendRequests FriendRequest[] @relation("FriendRequestsReceived")

  // friendshipsAsUser1 Friendship[] @relation("FriendshipsAsUser1")
  // friendshipsAsUser2 Friendship[] @relation("FriendshipsAsUser2")

  // sentMessages Message[]

  // Relations
  createdChallenges Challenge[]

  createdBattles Battle[] @relation("BattleCreator")

  joinedBattles Battle[] @relation("BattlePlayers")

  wonBattles Battle[] @relation("BattleWinner")
}




