datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ONLINE
  OFFLINE
  IN_BATTLE
}

enum BattleMode {
  SOLO
  DUO
  GROUP
}

enum BattleStatus {
  WAITING
  RUNNING
  COMPLETED
  CANCELLED
}

enum BattleVisibility {
  PUBLIC
  PRIVATE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  C
  CPP
}

model User {
  id String @id @default(uuid())

  globalRank Int @default(autoincrement())

  name          String

  email    String  @unique
  // password string

  role   UserRole   @default(USER)
  status UserStatus @default(OFFLINE)

  level Int @default(0)
  exp   Int @default(0)

  wins   Int @default(0)
  losses Int @default(0)

  totalChallengesPlayed  Int @default(0)
  totalChallengesCreated Int @default(0)

  lastSeen DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // sentFriendRequests     FriendRequest[] @relation("FriendRequestsSent")
  // receivedFriendRequests FriendRequest[] @relation("FriendRequestsReceived")

  // friendshipsAsUser1 Friendship[] @relation("FriendshipsAsUser1")
  // friendshipsAsUser2 Friendship[] @relation("FriendshipsAsUser2")

  // sentMessages Message[]

  // Relations
  createdChallenges Challenge[]

  createdBattles Battle[] @relation("BattleCreator")

  joinedBattles Battle[] @relation("BattlePlayers")

  wonBattles    Battle[]  @relation("BattleWinner")
  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

